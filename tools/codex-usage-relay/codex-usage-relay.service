[Unit]
Description=Codex usage relay for Clawdmeter
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/codex-usage-relay/relay.py --host 100.0.0.0 --port 8765
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes

[Install]
WantedBy=default.target
